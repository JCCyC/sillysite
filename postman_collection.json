    {
      "name": "Login",
      "description": "Computing the challenge response requires PBKDF2-HMAC-SHA256, which isn't available in Postman's sandbox. Use `./login.py <base_url> <username>` to actually log in; these requests are included for reference.",
      "item": [
        {
          "name": "Get Challenge",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\"\n}"
            },
            "url": "{{base_url}}/login/challenge"
          }
        },
        {
          "name": "Submit Response",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"challenge\": \"<challenge from Get Challenge>\",\n  \"response\": \"<HMAC-SHA256(PBKDF2-HMAC-SHA256(password, salt, iterations), challenge)>\"\n}"
            },
            "url": "{{base_url}}/login/response"
          }
        }
      ]
    },
    {
      "name": "Change Password",
      "description": "Computing a PBKDF2 salt/hash for the new password isn't possible in Postman's sandbox. Use `./changepw.py <base_url> <username>` to actually change a password; this request is included for reference.",
      "item": [
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "<session token from Login>"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"new_salt\": \"<random hex salt>\",\n  \"new_password_hash\": \"<PBKDF2-HMAC-SHA256(new_password, new_salt, new_iterations)>\",\n  \"new_iterations\": 200000\n}"
            },
            "url": "{{base_url}}/change-password"
          }
        }
      ]
    },
