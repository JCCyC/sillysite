{
  "info": {
    "name": "Silly Site API",
    "description": "Collection for testing the Silly Site FastAPI app.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "api_key",
      "value": "changeme"
    }
  ],
  "item": [
    {
      "name": "General",
      "item": [
        {
          "name": "Home",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/"
          }
        },
        {
          "name": "About",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/about"
          }
        },
        {
          "name": "Favicon",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/favicon.ico"
          }
        },
        {
          "name": "Login Page",
          "description": "Serves a login form that implements the login flow in the browser. If a valid X-API-Key/apikey is already supplied, returns the /whoami result directly instead.",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/login.html"
          }
        },
        {
          "name": "Who Am I Page",
          "description": "Displays the current user's /whoami information, styled like /login.html. Redirects to /login.html if no valid X-API-Key/apikey is supplied.",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/whoami.html?apikey={{api_key}}"
          }
        }
      ]
    },
    {
      "name": "Teams",
      "item": [
        {
          "name": "List Teams",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/teams"
          }
        },
        {
          "name": "Get Team",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/teams/1"
          }
        },
        {
          "name": "Create Team",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Team\",\n  \"country\": \"Testland\",\n  \"founded_year\": 2020\n}"
            },
            "url": "{{base_url}}/teams"
          }
        },
        {
          "name": "Update Team",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Team\",\n  \"country\": \"Testland\",\n  \"founded_year\": 2021\n}"
            },
            "url": "{{base_url}}/teams/1"
          }
        },
        {
          "name": "Delete Team",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": "{{base_url}}/teams/1"
          }
        }
      ]
    },
