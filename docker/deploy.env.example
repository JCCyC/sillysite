# Copy this file to deploy.env and adjust as needed, then run ./deploy.sh

# Host port the API will be reachable on.
API_PORT=19505

# Whether to expose PostgreSQL on the host at all (yes/no).
EXPOSE_POSTGRES=no

# Host port for PostgreSQL, only used if EXPOSE_POSTGRES=yes.
POSTGRES_PORT=55432

# Resource limits for the container.
MEMORY_LIMIT=1g
CPU_LIMIT=1.0

# Maximum size of the application database, in megabytes. Once exceeded,
# the database is switched to read-only for new connections until it
# shrinks back under the limit. Set to 0 to disable.
DB_SIZE_LIMIT_MB=0

# --- Optional overrides ---
# Leave these unset to use the built-in defaults (a random DB password
# and API key are generated on first run and persisted in the
# sillysite_state volume; check the container logs to retrieve the
# generated API key).
#DB_NAME=sillysite
#DB_USER=sillysite
#DB_PASSWORD=
#API_KEY=
#WEB_CONCURRENCY=2
#SEED_DB=false
