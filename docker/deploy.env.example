# Copy this file to deploy.env and adjust as needed, then run ./deploy.sh

# Host port the API will be reachable on.
API_PORT=19505

# Whether to expose PostgreSQL on the host at all (yes/no).
EXPOSE_POSTGRES=no

# Host port for PostgreSQL, only used if EXPOSE_POSTGRES=yes.
POSTGRES_PORT=55432

# Resource limits for the container.
MEMORY_LIMIT=1g
CPU_LIMIT=1.0

# Maximum size of the application database, in megabytes. Once exceeded,
# the database is switched to read-only for new connections until it
# shrinks back under the limit. Set to 0 to disable.
DB_SIZE_LIMIT_MB=0

# Whether the API is served over HTTPS (yes/no). Leaving TLS_CERT_FILE/
# TLS_KEY_FILE unset (the default) generates a self-signed certificate
# automatically (100-year expiry, persisted across restarts) -- clients
# will need to ignore/trust it manually (e.g. curl -k), since it isn't
# signed by a CA any client already trusts. Set TLS_CERT_FILE/TLS_KEY_FILE
# below instead to use a real certificate (e.g. one issued by Let's
# Encrypt or an internal CA).
TLS_ENABLED=yes

# --- Optional overrides ---
# Leave these unset to use the built-in defaults (a random DB password
# and API key are generated on first run and persisted in the
# sillysite_state volume; check the container logs to retrieve the
# generated API key).
#DB_NAME=sillysite
#DB_USER=sillysite
#DB_PASSWORD=
#API_KEY=
#WEB_CONCURRENCY=2
#SEED_DB=false

# Hostname or IP the self-signed certificate's CN/SAN should cover (in
# addition to localhost/127.0.0.1, which are always included). Only
# relevant when using the auto-generated self-signed certificate -- has no
# effect if TLS_CERT_FILE/TLS_KEY_FILE are set below.
#TLS_HOSTNAME=

# Host paths to an existing certificate/private key to use instead of the
# self-signed default. Both must be set together.
#TLS_CERT_FILE=
#TLS_KEY_FILE=
